# Settings for the docker-compose stack (docker compose --env-file docker.env up --build -d).
# Do not edit this template - run ./scripts/gen-docker-env.sh to create a real docker.env
# (gitignored) with random secrets, then fill in the two values it can't invent.

# --- generated by the script ---
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
JWT_KEY=
# Must be the same value for the .NET API and the Python service.
INTERNAL_API_KEY=
# Passwords for the RabbitMQ and Redis containers (never published outside the compose network).
RABBITMQ_PASSWORD=
REDIS_PASSWORD=

# --- you provide these ---
# Required for chat replies: https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=
# Optional: only needed for real forgot-password emails (Gmail address + 16-character App Password).
SMTP_USERNAME=
SMTP_PASSWORD=

# Where users reach the app in a browser. Password-reset links point here.
# docker-compose publishes the site on port 8080.
PUBLIC_URL=http://localhost:8080

# Optional: set to true to produce AI replies in the background (the chat answers 202 and the reply appears by itself).
# Needs RabbitMQ (included). Passed to the api as Chat__AsyncReplies. Default: false.
CHAT_ASYNC_REPLIES=false

# Optional: the email of the account that becomes the first Admin. Works only while nobody is an Admin, at the next start or login of that
# account (register it first). Leave blank to grant Admin by hand instead (see README, "Becoming an Admin").
ADMIN_BOOTSTRAP_EMAIL=

# What the AI provider charges, in US dollars per million tokens. An estimate shown on the admin usage page; check the provider's price list
# for the model in use (DEEPINFRA_MODEL) and change these when it changes. Defaults are placeholders.
PRICE_INPUT_PER_MILLION=0.05
PRICE_OUTPUT_PER_MILLION=0.08
