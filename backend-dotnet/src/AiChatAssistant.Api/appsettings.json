{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "AiChatAssistant",
    "Audience": "AiChatAssistant.Client",
    "ExpiryMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200"]
  },
  "PythonService": {
    "BaseUrl": "http://localhost:8000"
  },
  "Frontend": {
    "BaseUrl": "http://localhost:4200"
  },
  "RabbitMq": {
    "Host": "",
    "Port": 5672,
    "VirtualHost": "/"
  },
  "Redis": {
    "ConnectionString": ""
  },
  "Email": {
    "Provider": "smtp",
    "RetryDelaysSeconds": [10, 60],
    "MessageTtlMinutes": 60,
    "Prefetch": 4
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "FromName": "AI Chat Assistant"
  }
}
