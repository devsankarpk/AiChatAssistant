# Copy to .env (gitignored) and fill in real values:
#   cp env.example .env

# DeepInfra (OpenAI-compatible API - https://deepinfra.com). Get a key at
# https://deepinfra.com/dash/api_keys.
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
# Small, cheap instruct model - fine for a demo. See https://deepinfra.com/pricing
# for the current catalog if you want to swap it.
DEEPINFRA_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo

# Shared secret with backend-dotnet - must match the .NET side's InternalApiKey
# (or Internal__ApiKey env var) exactly, once Phase 4 wires them together.
INTERNAL_API_KEY=
