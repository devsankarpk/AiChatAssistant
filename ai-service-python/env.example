# Copy to .env (gitignored) and fill in real values:
#   cp env.example .env

# DeepInfra (OpenAI-compatible API - https://deepinfra.com). Get a key at
# https://deepinfra.com/dash/api_keys.
DEEPINFRA_API_KEY=
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
# Chosen for generation speed (~60 tok/s measured vs ~5 tok/s for Llama 3.1 8B Turbo on
# 2026-09-29) - replies must finish inside the ~50s timeout budget in llm_client.py.
# See https://deepinfra.com/pricing for the catalog if you want to swap it.
DEEPINFRA_MODEL=mistralai/Mistral-Small-24B-Instruct-2501
# Upper bound on reply length, in tokens.
DEEPINFRA_MAX_TOKENS=600

# Shared secret with backend-dotnet - must match the .NET side's InternalApiKey
# (or Internal__ApiKey env var) exactly, once Phase 4 wires them together.
INTERNAL_API_KEY=
